          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"owner_type\" TEXT NOT NULL, \"owner_id\" INTEGER NOT NULL, \"file_name\" TEXT NOT NULL, \"file_path\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"size\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"uuid\" TEXT NOT NULL DEFAULT '');"
