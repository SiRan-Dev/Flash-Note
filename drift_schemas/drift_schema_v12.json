        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_messages\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"inspiration_id\" INTEGER NOT NULL, \"role\" TEXT NOT NULL, \"content\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"uuid\" TEXT NOT NULL DEFAULT '');"
